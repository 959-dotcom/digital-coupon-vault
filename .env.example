# Copy to .env at the repository root. Never commit the filled file.
# Placeholder values below are not production secrets.

DATABASE_URL=postgresql://coupon:coupon@localhost:5432/coupon?schema=public
REDIS_URL=redis://localhost:6379

# 32+ characters. Generate your own before running the API.
JWT_SECRET=replace-with-a-long-random-jwt-secret-value
JWT_EXPIRES_IN=12h

# Mixed into the vault preimage. 32+ characters.
SERVER_VAULT_SECRET=replace-with-a-long-random-vault-secret-value

# HMAC-SHA256 key for state-changing routes. 32+ characters.
HMAC_SECRET=replace-with-a-long-random-hmac-secret-value

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000

# Used only by prisma/seed.ts
SEED_PASSWORD=replace-with-a-local-seed-password
