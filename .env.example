# Copy to .env at the repository root. Never commit the filled file.
# Placeholder values below are not production secrets.
#
# Hub cutover (project aozoakeghslgnhdegdyr), after pasting
# apps/api/prisma/hub/coupon_schema.sql once in the Hub SQL editor:
# set DATABASE_URL to that project's Postgres URI with schema=coupon.
# The API uses schema coupon only when the URI contains that project ref.
# Leave the previous database running. This app does not delete it.
# Until DATABASE_URL changes, queries stay on that database's public schema.
# Local Docker stays on schema public.

DATABASE_URL=postgresql://coupon:coupon@localhost:5432/coupon?schema=public
# Optional. Local Docker Redis. Leave unset to use the database rate limiter and skip BullMQ.
REDIS_URL=redis://localhost:6379

# 32+ characters. Generate your own before running the API.
JWT_SECRET=replace-with-a-long-random-jwt-secret-value
JWT_EXPIRES_IN=12h

# Mixed into the vault preimage. 32+ characters.
SERVER_VAULT_SECRET=replace-with-a-long-random-vault-secret-value

# HMAC-SHA256 key for state-changing routes. 32+ characters.
HMAC_SECRET=replace-with-a-long-random-hmac-secret-value

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000

# Required only for the Vercel cron route.
CRON_SECRET=replace-with-a-long-random-cron-secret

# Optional. Empty means the oracle job logs a no-op and does not fetch.
ORACLE_SOURCE_URLS=

# Used only by prisma/seed.ts
SEED_PASSWORD=replace-with-a-local-seed-password
