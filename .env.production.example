# Copy to .env on the VPS. Placeholders only. Do not commit the filled file.

# Runtime connection for the API and the batch worker.
# On Supabase this is the pooler (pgbouncer, transaction mode, port 6543).
# Add pgbouncer=true so Prisma does not use prepared statements on that pool.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?pgbouncer=true&schema=public

# Direct connection (session mode, port 5432). Do not use this as the running
# DATABASE_URL. prisma migrate deploy needs it: pgbouncer transaction mode does
# not keep the session Prisma uses for its advisory lock. For that command only:
#   DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public" npm run prisma:migrate

REDIS_URL=redis://redis:6379

# 32+ characters. Generate a unique value for this deployment.
JWT_SECRET=replace-with-a-long-random-jwt-secret-value
JWT_EXPIRES_IN=12h

# Mixed into the vault preimage. 32+ characters.
SERVER_VAULT_SECRET=replace-with-a-long-random-vault-secret-value

# HMAC-SHA256 key shared by the web proxy and the API. 32+ characters.
HMAC_SECRET=replace-with-a-long-random-hmac-secret-value

# Public origins for this deployment.
NEXT_PUBLIC_API_URL=https://api.db357.com
CORS_ORIGIN=https://app.db357.com
APP_URL=https://app.db357.com

# Optional comma-separated result sources. Leave empty and the oracle job no-ops.
# Put any token in this variable on the host. Do not commit it.
ORACLE_SOURCE_URLS=

API_PORT=4000
WEB_ORIGIN=https://app.db357.com
# Server-side proxy target. Inside Compose the web container uses the API service.
API_INTERNAL_URL=http://api:4000

# Used only by prisma/seed.ts
SEED_PASSWORD=replace-with-a-seed-password
