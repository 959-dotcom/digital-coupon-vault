# Placeholders for the Vercel dashboard. Do not commit a filled copy.
# Redis is local Docker only. Leave REDIS_URL unset on Vercel.

# Supabase pooler (pgbouncer, transaction mode, port 6543) for the running API.
# Add pgbouncer=true so Prisma does not use prepared statements on that pool.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?pgbouncer=true&schema=public

# Direct Supabase URL (session mode, port 5432). Do not put this in the Vercel runtime.
# prisma migrate deploy needs it because pgbouncer transaction mode does not keep
# the session Prisma uses for its advisory lock. For that command only:
#   DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public" npm run prisma:migrate

# 32+ characters. Generate a unique value for this deployment.
JWT_SECRET=replace-with-a-long-random-jwt-secret-value
JWT_EXPIRES_IN=12h

# Mixed into the vault preimage. 32+ characters.
SERVER_VAULT_SECRET=replace-with-a-long-random-vault-secret-value

# HMAC-SHA256 key shared by the web proxy and the API. 32+ characters. Same value on both projects.
HMAC_SECRET=replace-with-a-long-random-hmac-secret-value

# Vercel Cron sends Authorization: Bearer this value. Long random string.
CRON_SECRET=replace-with-a-long-random-cron-secret

NEXT_PUBLIC_API_URL=https://api.db357.com
CORS_ORIGIN=https://app.db357.com
APP_URL=https://app.db357.com

# Web project server-side proxy. On Vercel set this to the public API origin.
API_INTERNAL_URL=https://api.db357.com

# Optional comma-separated result sources. Empty means the oracle job no-ops.
ORACLE_SOURCE_URLS=

# Used only by prisma/seed.ts. Not required by the running app.
SEED_PASSWORD=replace-with-a-seed-password
