generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  MASTER_PARTNER
  PARTNER
  MEMBER
}

enum DistributionMode {
  COMMISSION_ONLY
  FULL_PASS
  SPLIT_KEEP
}

enum TxStatus {
  PENDING
  CONFIRMED
  SETTLED
  CANCELLED_SYSTEM
}

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
}

enum PercentLockMode {
  ADMIN_LOCK
  SELF_MANAGE
}

enum CreditKind {
  MINT
  BURN
  TRANSFER
}

model Partner {
  id               String             @id @default(uuid())
  code             String             @unique
  name             String
  parentId         String?
  parent           Partner?           @relation("Downline", fields: [parentId], references: [id])
  children         Partner[]          @relation("Downline")
  /// PostgreSQL ltree. The migration casts this column and adds a GiST index.
  path             String             @unique
  distributionMode DistributionMode
  /// Category code to decimal rate string, for example { "D2": "0.1000" }.
  commissionRates  Json
  isActive         Boolean            @default(true)
  users            User[]
  transactions     CouponTx[]
  commissions      CommissionRecord[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([parentId])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  displayName  String
  role         Role
  partnerId    String?
  partner      Partner?   @relation(fields: [partnerId], references: [id])
  isActive     Boolean    @default(true)
  parentId     String?
  parent       User?      @relation("UserLine", fields: [parentId], references: [id])
  children     User[]     @relation("UserLine")
  /// PostgreSQL ltree of referral codes from the root account.
  path         String     @unique
  referralCode String     @unique
  /// Percent of a bill this account keeps. The rest rolls up. 0 skips them.
  holdPercent  Decimal    @default(0) @db.Decimal(6, 2)
  /// Commission-only accounts share a link and earn hold, without their own bills.
  commissionOnly Boolean  @default(false)
  transactions CouponTx[]
  withdrawals  Withdrawal[]
  notifications Notification[]
  creditAccount CreditAccount?
  creditSent    CreditTransaction[] @relation("CreditSent")
  creditReceived CreditTransaction[] @relation("CreditReceived")
  billShares    BillShare[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([partnerId])
  @@index([parentId])
}

model CouponCategory {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  description   String
  /// Wall-clock cutoff in Asia/Bangkok, HH:mm. Compared with the server clock only.
  cutoffTime    String
  /// Days, weekdays, sessions, or the Yeekee interval. The server computes the next cutoff from this.
  schedule      Json
  isActive      Boolean       @default(true)
  gridMin       Int
  gridMax       Int
  pad           Int
  stakeAmounts  Json
  batches       CouponBatch[]
  transactions  CouponTx[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model CouponBatch {
  id           String         @id @default(uuid())
  categoryId   String
  category     CouponCategory @relation(fields: [categoryId], references: [id])
  batchDate    DateTime       @db.Date
  /// Session cutoff HH:mm, or a Yeekee slot such as 01.
  slot         String
  label        String
  isOpen       Boolean        @default(true)
  settledAt    DateTime?
  outcome      Json?
  transactions CouponTx[]
  createdAt    DateTime       @default(now())

  @@unique([categoryId, batchDate, slot])
  @@index([categoryId])
}

model CouponTx {
  id             String             @id
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  partnerId      String
  partner        Partner            @relation(fields: [partnerId], references: [id])
  categoryId     String
  category       CouponCategory     @relation(fields: [categoryId], references: [id])
  batchId        String
  batch          CouponBatch        @relation(fields: [batchId], references: [id])
  items          Json
  totalAmount    Decimal            @db.Decimal(15, 4)
  status         TxStatus
  txHash         String             @unique
  idempotencyKey String?            @unique
  createdAt      DateTime
  confirmedAt    DateTime?
  commissions    CommissionRecord[]
  billShares     BillShare[]

  @@index([userId, createdAt])
  @@index([partnerId])
  @@index([categoryId])
  @@index([batchId])
  @@index([status])
}

model CommissionRecord {
  id            String           @id @default(uuid())
  transactionId String
  transaction   CouponTx         @relation(fields: [transactionId], references: [id])
  partnerId     String
  partner       Partner          @relation(fields: [partnerId], references: [id])
  categoryCode  String
  rate          Decimal          @db.Decimal(5, 4)
  baseAmount    Decimal          @db.Decimal(15, 4)
  amount        Decimal          @db.Decimal(15, 4)
  mode          DistributionMode
  createdAt     DateTime         @default(now())

  @@index([transactionId])
  @@index([partnerId])
}

model Withdrawal {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Decimal  @db.Decimal(15, 4)
  destination String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  target    String
  detail    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String
  title     String
  body      String
  readAt    DateTime?
  dedupeKey String    @unique
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model RateBucket {
  bucket  String   @id
  hits    Int
  resetAt DateTime
}

model RequestNonce {
  nonce     String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

model LedgerEntry {
  id            String      @id @default(uuid())
  transactionId String
  accountType   AccountType
  accountCode   String
  debit         Decimal     @db.Decimal(15, 4)
  credit        Decimal     @db.Decimal(15, 4)
  memo          String
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([accountCode])
}

model SystemSetting {
  id                String          @id @default("default")
  adminBasePercent  Decimal         @default(5) @db.Decimal(4, 2)
  percentLockMode   PercentLockMode @default(ADMIN_LOCK)
  updatedAt         DateTime        @updatedAt
}

model CreditAccount {
  userId  String  @id
  user    User    @relation(fields: [userId], references: [id])
  balance Decimal @default(0) @db.Decimal(15, 4)
}

model CreditTransaction {
  id              String     @id @default(uuid())
  kind            CreditKind
  senderId        String?
  sender          User?      @relation("CreditSent", fields: [senderId], references: [id])
  receiverId      String?
  receiver        User?      @relation("CreditReceived", fields: [receiverId], references: [id])
  amount          Decimal    @db.Decimal(15, 4)
  senderBefore    Decimal?   @db.Decimal(15, 4)
  senderAfter     Decimal?   @db.Decimal(15, 4)
  receiverBefore  Decimal?   @db.Decimal(15, 4)
  receiverAfter   Decimal?   @db.Decimal(15, 4)
  createdAt       DateTime   @default(now())

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
}

/// Immutable slice of a confirmed bill. One row per account on the seller's line.
model BillShare {
  id                 String   @id @default(uuid())
  transactionId      String
  transaction        CouponTx @relation(fields: [transactionId], references: [id])
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  holdPercent        Decimal  @db.Decimal(6, 2)
  amount             Decimal  @db.Decimal(15, 4)
  receivedFromBelow  Decimal  @db.Decimal(15, 4)
  sentUpward         Decimal  @db.Decimal(15, 4)
  createdAt          DateTime @default(now())

  @@unique([transactionId, userId])
  @@index([userId])
}
