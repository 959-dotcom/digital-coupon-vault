{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci --prefix ../..",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/cron/batch", "schedule": "0 0 * * *" }]
}
