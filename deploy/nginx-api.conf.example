# Example for api.db357.com. Listens on 443 and proxies to the Compose API
# on port 4000. Point the certificate files at the real certs on the host.

server {
  listen 443 ssl;
  server_name api.db357.com;

  ssl_certificate     /etc/nginx/certs/api.db357.com.crt;
  ssl_certificate_key /etc/nginx/certs/api.db357.com.key;

  location / {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
